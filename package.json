{
	"name": "game-template",
	"description": "A studio's repository to start from: Studio Name, with one small slot, Game Title, built on the Rolarie SDK.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"scripts": {
		"books": "rolarie-studio books",
		"client": "rolarie-studio client",
		"check": "rolarie-studio check",
		"dev": "rolarie-studio dev game-title",
		"stories": "rolarie-studio stories",
		"pack": "rolarie-studio pack",
		"make": "rolarie-studio make",
		"test": "bun node_modules/vitest/vitest.mjs --run",
		"test:browser": "bun node_modules/@playwright/test/cli.js install chromium && bun node_modules/@playwright/test/cli.js test",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"dependencies": {
		"@rolarie/sdk": "github:Rolarie/sdk#v0.31.0",
		"pixi.js": "^8.23.0",
		"svelte": "^5.57.2",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@storybook/svelte-vite": "^10.6.7",
		"@types/bun": "^1.4.4",
		"@types/node": "^22",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	}
}
